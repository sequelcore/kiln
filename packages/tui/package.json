{
  "name": "@kilnai/tui",
  "version": "1.0.7",
  "description": "Terminal interface for Kiln. EXPERIMENTAL — frozen per ADR-005, maintenance-only, scheduled for deletion in Phase I after GUI parity.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts tests"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kilnai/gateway-contracts": "workspace:*",
    "@opentui/core": "0.1.92",
    "@opentui/react": "0.1.92"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "0.1.92",
    "@opentui/core-darwin-x64": "0.1.92",
    "@opentui/core-linux-arm64": "0.1.92",
    "@opentui/core-linux-x64": "0.1.92",
    "@opentui/core-win32-arm64": "0.1.92",
    "@opentui/core-win32-x64": "0.1.92"
  },
  "peerDependencies": {
    "@kilnai/core": "^1.0.7",
    "@kilnai/cli": "^1.0.7",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  }
}
