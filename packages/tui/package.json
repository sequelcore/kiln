{
  "name": "@kilnai/tui",
  "version": "3.0.0-beta.1",
  "description": "Interactive terminal operator surface for the Kiln control plane",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun ../../scripts/clean-typescript-output.ts && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts tests"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sequelcore/kiln.git",
    "directory": "packages/tui"
  },
  "homepage": "https://github.com/sequelcore/kiln/tree/main/packages/tui",
  "keywords": [
    "kiln",
    "tui",
    "terminal",
    "agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kilnai/gateway-contracts": "3.0.0-beta.1",
    "@kilnai/operator-appearance": "3.0.0-beta.1",
    "@opentui/core": "0.1.92",
    "@opentui/react": "0.1.92",
    "@kilnai/core": "3.0.0-beta.1",
    "react": "^19.0.0"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "0.1.92",
    "@opentui/core-darwin-x64": "0.1.92",
    "@opentui/core-linux-arm64": "0.1.92",
    "@opentui/core-linux-x64": "0.1.92",
    "@opentui/core-win32-arm64": "0.1.92",
    "@opentui/core-win32-x64": "0.1.92"
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  }
}
