{
  "name": "@kilnai/runtime",
  "version": "3.0.0-beta.1",
  "description": "Gateway runtime and channel adapters for the Kiln control plane",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "native",
    "README.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/clean-typescript-output.ts && tsc",
    "build:windows-uia": "native\\windows-uia\\build.cmd",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --exclude \"tests/managed-agent/*.live.test.ts\" --silent=passed-only",
    "test:profile": "vitest run --maxWorkers=1 --exclude \"tests/managed-agent/*.live.test.ts\" --reporter=json --outputFile=../../.kiln/runtime-vitest-profile.json",
    "test:live": "vitest run --dir tests/managed-agent .live.test --maxWorkers=1"
  },
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sequelcore/kiln.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/sequelcore/kiln/tree/main/packages/runtime",
  "keywords": [
    "ai",
    "gateway",
    "multi-tenant",
    "whatsapp",
    "slack",
    "channels",
    "hono"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kilnai/gateway-contracts": "3.0.0-beta.1",
    "hono": "^4.7.0",
    "jose": "^5.0.0",
    "sharp": "^0.34.5",
    "unpdf": "^1.6.2",
    "@kilnai/core": "3.0.0-beta.1",
    "@kilnai/gui": "3.0.0-beta.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentelemetry/api": "^1.9.0",
    "ioredis": ">=5.0.0",
    "@nut-tree/nut-js": "^5.1.1",
    "playwright": "^1.59.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "@nut-tree/nut-js": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  }
}
