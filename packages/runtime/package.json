{
  "name": "@kilnai/runtime",
  "version": "3.0.0-beta.1",
  "description": "Gateway runtime and channel adapters for the Kiln control plane",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "native",
    "README.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/clean-typescript-output.ts && tsc",
    "build:windows-uia": "native\\windows-uia\\build.cmd",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --silent=passed-only && bun run test:model-gateway:listener:bun && bun run test:model-gateway:sqlite:bun && bun run test:managed-economic-authority:sqlite:bun",
    "test:model-gateway:listener:bun": "bun tests/model-gateway/model-gateway-listener.bun.ts",
    "test:model-gateway:sqlite:bun": "bun tests/model-gateway/local-model-gateway-store.bun.ts",
    "test:managed-economic-authority:sqlite:bun": "bun tests/managed-account-leases/managed-economic-commitment-authority.bun.ts",
    "test:profile": "vitest run --reporter=json --outputFile=../../.kiln/runtime-vitest-profile.json",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sequelcore/kiln.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/sequelcore/kiln/tree/main/packages/runtime",
  "keywords": [
    "ai",
    "gateway",
    "multi-tenant",
    "whatsapp",
    "slack",
    "channels",
    "hono"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@kilnai/core": "3.0.0-beta.1",
    "@kilnai/gateway-contracts": "3.0.0-beta.1",
    "@kilnai/gui": "3.0.0-beta.1",
    "hono": "^4.7.0",
    "jose": "^5.0.0",
    "sharp": "^0.34.5",
    "unpdf": "^1.6.2"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "ioredis": ">=5.0.0",
    "@nut-tree/nut-js": "^5.1.1",
    "playwright": "^1.59.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "@nut-tree/nut-js": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  }
}
