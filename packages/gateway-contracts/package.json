{
  "name": "@kilnai/gateway-contracts",
  "version": "3.0.0-beta.1",
  "description": "Shared HTTP/WebSocket frame contracts between the Kiln runtime gateway and operator surfaces",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./voice-output-parts": {
      "types": "./dist/voice-output-parts.d.ts",
      "development": "./src/voice-output-parts.ts",
      "import": "./dist/voice-output-parts.js"
    },
    "./voice-input-parts": {
      "types": "./dist/voice-input-parts.d.ts",
      "development": "./src/voice-input-parts.ts",
      "import": "./dist/voice-input-parts.js"
    },
    "./image-input-parts": {
      "types": "./dist/image-input-parts.d.ts",
      "development": "./src/image-input-parts.ts",
      "import": "./dist/image-input-parts.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/clean-typescript-output.ts && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sequelcore/kiln.git",
    "directory": "packages/gateway-contracts"
  },
  "homepage": "https://github.com/sequelcore/kiln/tree/main/packages/gateway-contracts",
  "keywords": [
    "ai",
    "gateway",
    "contracts",
    "websocket"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
