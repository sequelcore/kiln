{
  "$id": "https://kiln.dev/schemas/project-config-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical schema for private project config.yaml.",
  "properties": {
    "activeInstructionProfiles": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "x-kiln-project-admission": "attenuation-only",
      "x-kiln-project-comparator": "global-instruction-profile-subset"
    },
    "channels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "communication": {
      "additionalProperties": false,
      "description": "Provider-neutral operator communication intent.",
      "properties": {
        "artifactContract": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "revision": {
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "type": "object"
        },
        "interactionProfile": {
          "additionalProperties": false,
          "properties": {
            "behaviors": {
              "items": {
                "anyOf": [
                  {
                    "const": "audience-calibrated",
                    "type": "string"
                  },
                  {
                    "const": "findings-first",
                    "type": "string"
                  },
                  {
                    "const": "next-action-explicit",
                    "type": "string"
                  },
                  {
                    "const": "outcome-first",
                    "type": "string"
                  },
                  {
                    "const": "plain-language",
                    "type": "string"
                  },
                  {
                    "const": "state-visible",
                    "type": "string"
                  }
                ]
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "id": {
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "revision": {
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "revision",
            "behaviors"
          ],
          "type": "object"
        },
        "locale": {
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "type": "string"
        },
        "onUnsupported": {
          "anyOf": [
            {
              "const": "deny",
              "type": "string"
            },
            {
              "const": "omit",
              "type": "string"
            }
          ]
        },
        "requiredContent": {
          "items": {
            "anyOf": [
              {
                "const": "approval-requirement",
                "type": "string"
              },
              {
                "const": "citation",
                "type": "string"
              },
              {
                "const": "decision",
                "type": "string"
              },
              {
                "const": "failure",
                "type": "string"
              },
              {
                "const": "finding",
                "type": "string"
              },
              {
                "const": "next-action",
                "type": "string"
              },
              {
                "const": "residual-risk",
                "type": "string"
              },
              {
                "const": "verification",
                "type": "string"
              },
              {
                "const": "warning",
                "type": "string"
              }
            ]
          },
          "type": "array"
        },
        "responseDetail": {
          "anyOf": [
            {
              "const": "provider-default",
              "type": "string"
            },
            {
              "const": "concise",
              "type": "string"
            },
            {
              "const": "standard",
              "type": "string"
            },
            {
              "const": "detailed",
              "type": "string"
            }
          ]
        },
        "responseSkills": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
                "type": "string"
              },
              "revision": {
                "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "revision"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object",
      "x-kiln-project-admission": "project-owned",
      "x-kiln-semantic-owner": "communication-policy"
    },
    "contextGovernance": {
      "additionalProperties": false,
      "description": "Project context allocation and adaptation intent.",
      "properties": {
        "adaptation": {
          "additionalProperties": false,
          "properties": {
            "activeConfigurationHash": {
              "minLength": 1,
              "type": "string"
            },
            "activePolicyId": {
              "minLength": 1,
              "type": "string"
            },
            "freezeReason": {
              "type": "string"
            },
            "frozen": {
              "type": "boolean"
            },
            "revision": {
              "type": "number"
            },
            "rollback": {
              "additionalProperties": false,
              "properties": {
                "allocationMode": {
                  "anyOf": [
                    {
                      "const": "whole-block",
                      "type": "string"
                    },
                    {
                      "const": "segmented",
                      "type": "string"
                    },
                    {
                      "const": "retrieval-on-demand",
                      "type": "string"
                    }
                  ]
                },
                "configurationHash": {
                  "minLength": 1,
                  "type": "string"
                },
                "policyId": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "policyId",
                "configurationHash",
                "allocationMode"
              ],
              "type": "object"
            },
            "version": {
              "const": "policy-adaptation-selection-v1",
              "type": "string"
            }
          },
          "required": [
            "version",
            "revision",
            "activePolicyId",
            "activeConfigurationHash",
            "frozen"
          ],
          "type": "object"
        },
        "allocationMode": {
          "anyOf": [
            {
              "const": "whole-block",
              "type": "string"
            },
            {
              "const": "segmented",
              "type": "string"
            },
            {
              "const": "retrieval-on-demand",
              "type": "string"
            }
          ]
        },
        "cachePolicy": {
          "anyOf": [
            {
              "const": "off",
              "type": "string"
            },
            {
              "const": "prefer",
              "type": "string"
            }
          ]
        },
        "preferredSources": {
          "items": {
            "anyOf": [
              {
                "const": "ledger",
                "type": "string"
              },
              {
                "const": "artifact",
                "type": "string"
              },
              {
                "const": "summary",
                "type": "string"
              },
              {
                "const": "memory",
                "type": "string"
              }
            ]
          },
          "type": "array"
        },
        "previewBeforeApply": {
          "type": "boolean"
        },
        "summaryAggressiveness": {
          "anyOf": [
            {
              "const": "low",
              "type": "string"
            },
            {
              "const": "medium",
              "type": "string"
            },
            {
              "const": "high",
              "type": "string"
            }
          ]
        },
        "turnBudget": {
          "type": "number"
        }
      },
      "type": "object",
      "x-kiln-project-admission": "project-owned",
      "x-kiln-semantic-owner": "context-governance"
    },
    "domain": {
      "minLength": 1,
      "type": "string"
    },
    "maxDepth": {
      "minimum": 0,
      "type": "number",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-project-admission": "attenuation-only",
      "x-kiln-project-comparator": "global-limit-bound"
    },
    "mcp": {
      "additionalProperties": false,
      "description": "Project MCP server connection and capability admission intent.",
      "properties": {
        "servers": {
          "patternProperties": {
            "^(.*)$": {
              "additionalProperties": false,
              "properties": {
                "admission": {
                  "additionalProperties": false,
                  "properties": {
                    "prompts": {
                      "additionalProperties": false,
                      "properties": {
                        "allow": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "deny": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "resources": {
                      "additionalProperties": false,
                      "properties": {
                        "allow": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "deny": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "state": {
                      "anyOf": [
                        {
                          "const": "admitted",
                          "type": "string"
                        },
                        {
                          "const": "denied",
                          "type": "string"
                        }
                      ]
                    },
                    "tools": {
                      "additionalProperties": false,
                      "properties": {
                        "allow": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "deny": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "type": "object"
                },
                "enabled": {
                  "type": "boolean"
                },
                "maxCapabilities": {
                  "minimum": 0,
                  "type": "number"
                }
              },
              "type": "object",
              "x-kiln-project-admission": "attenuation-only",
              "x-kiln-project-comparator": "global-mcp-admission-narrowing"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "servers"
      ],
      "type": "object",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-project-admission": "attenuation-only",
      "x-kiln-project-comparator": "global-mcp-admission-narrowing",
      "x-kiln-semantic-owner": "mcp-configuration",
      "x-kiln-sensitivity": "secret-reference"
    },
    "parallelWorkers": {
      "minimum": 0,
      "type": "number",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-project-admission": "attenuation-only",
      "x-kiln-project-comparator": "global-limit-bound"
    },
    "permissions": {
      "additionalProperties": false,
      "description": "Project restrictions applied beneath global execution authority.",
      "properties": {
        "approval": {
          "anyOf": [
            {
              "const": "never",
              "type": "string"
            },
            {
              "const": "on-request",
              "type": "string"
            },
            {
              "const": "on-failure",
              "type": "string"
            },
            {
              "const": "untrusted",
              "type": "string"
            }
          ]
        },
        "sandbox": {
          "anyOf": [
            {
              "const": "read-only",
              "type": "string"
            },
            {
              "const": "workspace-write",
              "type": "string"
            },
            {
              "const": "danger-full-access",
              "type": "string"
            }
          ]
        }
      },
      "type": "object",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-project-admission": "attenuation-only",
      "x-kiln-project-comparator": "global-permission-narrowing",
      "x-kiln-semantic-owner": "model-facing-execution-authority"
    },
    "skills": {
      "additionalProperties": false,
      "description": "Project builtin-skill and selection intent.",
      "properties": {
        "builtin": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "exclude": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "include": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "selection": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "anyOf": [
                {
                  "const": "advisory",
                  "type": "string"
                },
                {
                  "const": "auto",
                  "type": "string"
                }
              ]
            }
          },
          "type": "object"
        }
      },
      "type": "object",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-project-admission": "attenuation-only",
      "x-kiln-project-comparator": "global-skill-selection-narrowing",
      "x-kiln-semantic-owner": "skills-configuration"
    },
    "version": {
      "const": "1",
      "description": "Breaking project configuration generation.",
      "type": "string"
    },
    "web": {
      "additionalProperties": false,
      "description": "Project web capability configuration.",
      "properties": {
        "allowedDomains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "netPolicy": {
          "anyOf": [
            {
              "const": "none",
              "type": "string"
            },
            {
              "const": "documentation",
              "type": "string"
            },
            {
              "const": "package-managers",
              "type": "string"
            },
            {
              "const": "full",
              "type": "string"
            }
          ]
        }
      },
      "type": "object",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-project-admission": "attenuation-only",
      "x-kiln-project-comparator": "global-web-capability-narrowing",
      "x-kiln-semantic-owner": "web-tools-configuration",
      "x-kiln-sensitivity": "secret-reference"
    },
    "workGovernance": {
      "additionalProperties": false,
      "description": "Project work-governance intent and evidence requirements.",
      "properties": {
        "boundedWorkCeiling": {
          "additionalProperties": false,
          "description": "Global bounded-work ceiling; project semantic admission forbids it.",
          "properties": {
            "allowedEffects": {
              "items": {
                "anyOf": [
                  {
                    "const": "inspect",
                    "type": "string"
                  },
                  {
                    "const": "modify_source",
                    "type": "string"
                  },
                  {
                    "const": "modify_tests",
                    "type": "string"
                  },
                  {
                    "const": "modify_documentation",
                    "type": "string"
                  },
                  {
                    "const": "modify_configuration",
                    "type": "string"
                  },
                  {
                    "const": "run_verification",
                    "type": "string"
                  },
                  {
                    "const": "invoke_managed_agent",
                    "type": "string"
                  },
                  {
                    "const": "external_write",
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            "allowedRoots": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "deniedRoots": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "maximumLimits": {
              "additionalProperties": false,
              "properties": {
                "maxChildDepth": {
                  "type": "number"
                },
                "maxConcurrentManagedInvocations": {
                  "type": "number"
                },
                "maxExecutionAttempts": {
                  "type": "number"
                },
                "maxManagedInvocations": {
                  "type": "number"
                },
                "maxRemediationRounds": {
                  "type": "number"
                },
                "maxReviewRounds": {
                  "type": "number"
                }
              },
              "type": "object"
            },
            "minimumHarnessCapability": {
              "anyOf": [
                {
                  "const": "authoritative",
                  "type": "string"
                },
                {
                  "const": "partially_enforced",
                  "type": "string"
                },
                {
                  "const": "advisory_only",
                  "type": "string"
                }
              ]
            }
          },
          "type": "object",
          "x-kiln-authority-impact": "authority-bearing",
          "x-kiln-project-admission": "forbidden",
          "x-kiln-semantic-owner": "bounded-work"
        },
        "defaultPosture": {
          "anyOf": [
            {
              "const": "orchestrate",
              "type": "string"
            },
            {
              "const": "direct",
              "type": "string"
            }
          ]
        },
        "requireDelegationFor": {
          "items": {
            "anyOf": [
              {
                "const": "architecture",
                "type": "string"
              },
              {
                "const": "security",
                "type": "string"
              },
              {
                "const": "ui",
                "type": "string"
              },
              {
                "const": "runtime",
                "type": "string"
              },
              {
                "const": "provider-routing",
                "type": "string"
              },
              {
                "const": "managed-agents",
                "type": "string"
              },
              {
                "const": "config",
                "type": "string"
              },
              {
                "const": "cross-surface",
                "type": "string"
              },
              {
                "const": "long-running",
                "type": "string"
              },
              {
                "const": "verification-heavy",
                "type": "string"
              },
              {
                "const": "formal-proof-candidate",
                "type": "string"
              }
            ]
          },
          "type": "array"
        },
        "requiredEvidence": {
          "items": {
            "anyOf": [
              {
                "const": "surface-map",
                "type": "string"
              },
              {
                "const": "risk-hypothesis",
                "type": "string"
              },
              {
                "const": "spec",
                "type": "string"
              },
              {
                "const": "plan",
                "type": "string"
              },
              {
                "const": "tests",
                "type": "string"
              },
              {
                "const": "typecheck",
                "type": "string"
              },
              {
                "const": "visual-reference-research",
                "type": "string"
              },
              {
                "const": "browser-qa",
                "type": "string"
              },
              {
                "const": "managed-agent-review",
                "type": "string"
              },
              {
                "const": "managed-orchestration:result-handoff",
                "type": "string"
              },
              {
                "const": "managed-orchestration:completion-signal",
                "type": "string"
              },
              {
                "const": "managed-orchestration:comparison-summary",
                "type": "string"
              },
              {
                "const": "managed-orchestration:route-outcome",
                "type": "string"
              },
              {
                "const": "managed-orchestration:adoption-gate",
                "type": "string"
              },
              {
                "const": "managed-orchestration:diff",
                "type": "string"
              },
              {
                "const": "managed-orchestration:verification",
                "type": "string"
              },
              {
                "const": "managed-orchestration:review",
                "type": "string"
              },
              {
                "const": "managed-orchestration:merge:compare-and-select",
                "type": "string"
              },
              {
                "const": "managed-orchestration:merge:collect-all",
                "type": "string"
              },
              {
                "const": "managed-orchestration:merge:first-success",
                "type": "string"
              },
              {
                "const": "managed-orchestration:merge:manual-review-required",
                "type": "string"
              },
              {
                "const": "managed-orchestration:merge:none",
                "type": "string"
              },
              {
                "const": "formal-proof",
                "type": "string"
              },
              {
                "const": "residual-risk",
                "type": "string"
              }
            ]
          },
          "type": "array"
        }
      },
      "type": "object",
      "x-kiln-activation": "next-turn",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-project-admission": "attenuation-only",
      "x-kiln-project-comparator": "global-work-governance-narrowing",
      "x-kiln-semantic-owner": "work-governance"
    }
  },
  "required": [
    "version"
  ],
  "title": "Kiln project configuration",
  "type": "object",
  "x-kiln-activation": "next-session",
  "x-kiln-authority-impact": "none",
  "x-kiln-default-posture": "omitted",
  "x-kiln-project-admission": "project-owned",
  "x-kiln-schema-revision": 1,
  "x-kiln-scope": "project",
  "x-kiln-semantic-owner": "project-configuration",
  "x-kiln-sensitivity": "public",
  "x-kiln-structural-owner": "project-configuration"
}
