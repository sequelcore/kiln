{
  "$id": "https://kiln.dev/schemas/global-config-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical structural schema for ~/.kiln/config.yaml.",
  "properties": {
    "activeInstructionProfiles": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "x-kiln-activation": "reconcile",
      "x-kiln-semantic-owner": "instruction-profiles"
    },
    "authorityProfiles": {
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "authority-profiles"
    },
    "communication": {
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "communication-policy"
    },
    "components": {
      "additionalProperties": false,
      "properties": {
        "include": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "deliberationPolicy": {
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "deliberation-policy"
    },
    "engines": {
      "patternProperties": {
        "^(.*)$": {
          "additionalProperties": false,
          "properties": {
            "billing": {
              "anyOf": [
                {
                  "const": "subscription",
                  "type": "string"
                },
                {
                  "const": "plus-quota",
                  "type": "string"
                },
                {
                  "const": "free",
                  "type": "string"
                },
                {
                  "const": "api-key",
                  "type": "string"
                },
                {
                  "const": "local",
                  "type": "string"
                }
              ]
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "hooks": {
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "hook-configuration"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "timezone": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object",
      "x-kiln-activation": "hot",
      "x-kiln-semantic-owner": "operator-preferences"
    },
    "interactiveUse": {
      "x-kiln-activation": "next-session",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "interactive-use"
    },
    "managedAgents": {
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "managed-agent-configuration"
    },
    "mcp": {
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "mcp-configuration",
      "x-kiln-sensitivity": "secret-reference"
    },
    "modelGateway": {
      "x-kiln-activation": "restart-required",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "model-gateway",
      "x-kiln-sensitivity": "secret-reference"
    },
    "modelTaskSuitability": {
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "model-task-suitability"
    },
    "operatorVoice": {
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "voice",
      "x-kiln-sensitivity": "secret-reference"
    },
    "permissionCeiling": {
      "additionalProperties": false,
      "properties": {
        "approval": {},
        "sandbox": {}
      },
      "type": "object"
    },
    "permissions": {
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "configured-permissions"
    },
    "sessionTurnBudget": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "stop",
          "type": "string"
        },
        "tokenLimit": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "tokenLimit",
        "action"
      ],
      "type": "object"
    },
    "skills": {
      "additionalProperties": false,
      "properties": {
        "builtin": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "exclude": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "include": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object",
          "x-kiln-activation": "reconcile",
          "x-kiln-authority-impact": "authority-bearing",
          "x-kiln-semantic-owner": "skill-catalog"
        },
        "externalCatalog": {
          "x-kiln-activation": "reconcile",
          "x-kiln-authority-impact": "authority-bearing",
          "x-kiln-semantic-owner": "skill-catalog"
        },
        "selection": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "anyOf": [
                {
                  "const": "advisory",
                  "type": "string"
                },
                {
                  "const": "auto",
                  "type": "string"
                }
              ]
            }
          },
          "type": "object",
          "x-kiln-activation": "next-session",
          "x-kiln-authority-impact": "authority-bearing",
          "x-kiln-semantic-owner": "skill-catalog"
        },
        "visibility": {
          "additionalProperties": false,
          "properties": {
            "default": {
              "anyOf": [
                {
                  "const": "implicit",
                  "type": "string"
                },
                {
                  "const": "explicit-only",
                  "type": "string"
                },
                {
                  "const": "disabled",
                  "type": "string"
                }
              ]
            },
            "overrides": {
              "patternProperties": {
                "^(.*)$": {
                  "anyOf": [
                    {
                      "const": "implicit",
                      "type": "string"
                    },
                    {
                      "const": "explicit-only",
                      "type": "string"
                    },
                    {
                      "const": "disabled",
                      "type": "string"
                    }
                  ]
                }
              },
              "type": "object"
            }
          },
          "type": "object",
          "x-kiln-activation": "reconcile",
          "x-kiln-authority-impact": "authority-bearing",
          "x-kiln-semantic-owner": "skill-catalog"
        }
      },
      "type": "object",
      "x-kiln-activation": "reconcile",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "skill-catalog"
    },
    "targetCatalog": {
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "execution-routing"
    },
    "targetRouting": {
      "additionalProperties": false,
      "properties": {
        "defaultTargetId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "defaultTargetId"
      ],
      "type": "object"
    },
    "ui": {
      "additionalProperties": false,
      "properties": {
        "appearance": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "anyOf": [
                {
                  "const": "system",
                  "type": "string"
                },
                {
                  "const": "light",
                  "type": "string"
                },
                {
                  "const": "dark",
                  "type": "string"
                }
              ]
            },
            "themeByScheme": {
              "additionalProperties": false,
              "properties": {
                "dark": {
                  "minLength": 1,
                  "type": "string"
                },
                "light": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "light",
                "dark"
              ],
              "type": "object"
            }
          },
          "required": [
            "mode",
            "themeByScheme"
          ],
          "type": "object"
        },
        "targetSelection": {
          "additionalProperties": false,
          "properties": {
            "accountOverrideId": {
              "minLength": 1,
              "type": "string"
            },
            "targetId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "targetId"
          ],
          "type": "object"
        }
      },
      "type": "object",
      "x-kiln-activation": "hot",
      "x-kiln-semantic-owner": "operator-preferences"
    },
    "verification": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "formal": {
          "additionalProperties": false,
          "properties": {
            "dafny": {
              "additionalProperties": false,
              "properties": {
                "executable": {
                  "minLength": 1,
                  "type": "string"
                },
                "expectedVersion": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "executable",
                "expectedVersion"
              ],
              "type": "object"
            },
            "screening": {
              "additionalProperties": false,
              "properties": {
                "lemmaScript": {
                  "additionalProperties": false,
                  "properties": {
                    "entrypoint": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "expectedVersion": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "packageRoot": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "packageRoot",
                    "entrypoint",
                    "expectedVersion"
                  ],
                  "type": "object"
                },
                "packagePath": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "packagePath",
                "lemmaScript"
              ],
              "type": "object"
            }
          },
          "required": [
            "dafny"
          ],
          "type": "object"
        },
        "inferential": {
          "additionalProperties": false,
          "properties": {
            "gentleAi": {
              "additionalProperties": false,
              "properties": {
                "executable": {
                  "minLength": 1,
                  "type": "string"
                },
                "expectedExecutableDigest": {
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "type": "string"
                },
                "expectedVersion": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "executable",
                "expectedVersion",
                "expectedExecutableDigest"
              ],
              "type": "object"
            }
          },
          "required": [
            "gentleAi"
          ],
          "type": "object"
        },
        "static": {
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "oxlint": {
              "additionalProperties": false,
              "properties": {
                "executable": {
                  "minLength": 1,
                  "type": "string"
                },
                "expectedVersion": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "executable",
                "expectedVersion"
              ],
              "type": "object"
            },
            "quality": {
              "additionalProperties": false,
              "properties": {
                "typescript": {
                  "items": {
                    "anyOf": [
                      {
                        "const": "type-integrity",
                        "type": "string"
                      },
                      {
                        "const": "complexity",
                        "type": "string"
                      },
                      {
                        "const": "test-integrity",
                        "type": "string"
                      }
                    ]
                  },
                  "maxItems": 3,
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                }
              },
              "required": [
                "typescript"
              ],
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "version": {
      "const": "5",
      "type": "string"
    },
    "web": {
      "additionalProperties": false,
      "properties": {
        "allowedDomains": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "extractProvider": {},
        "netPolicy": {
          "anyOf": [
            {
              "const": "none",
              "type": "string"
            },
            {
              "const": "documentation",
              "type": "string"
            },
            {
              "const": "package-managers",
              "type": "string"
            },
            {
              "const": "full",
              "type": "string"
            }
          ]
        },
        "searchFallbackProviders": {
          "items": {},
          "type": "array"
        },
        "searchProvider": {}
      },
      "type": "object"
    },
    "workGovernance": {
      "x-kiln-activation": "next-turn",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "work-governance"
    }
  },
  "required": [
    "version"
  ],
  "title": "Kiln global configuration",
  "type": "object",
  "x-kiln-activation": "next-session",
  "x-kiln-authority-impact": "none",
  "x-kiln-default-posture": "omitted",
  "x-kiln-schema-revision": 2,
  "x-kiln-scope": "global",
  "x-kiln-semantic-owner": "global-configuration",
  "x-kiln-sensitivity": "public",
  "x-kiln-structural-owner": "global-configuration"
}
