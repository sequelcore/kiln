{
  "name": "@kilnai/cli",
  "version": "3.0.0-beta.1",
  "description": "CLI and MCP surface for the Kiln control plane",
  "type": "module",
  "bin": {
    "kiln": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "verifiers",
    "README.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/clean-typescript-output.ts && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --reporter=dot --silent=passed-only",
    "test:verbose": "vitest run --maxWorkers=1 --reporter=verbose",
    "test:profile": "vitest run --maxWorkers=1 --reporter=json --outputFile=../../.kiln/cli-vitest-profile.json"
  },
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sequelcore/kiln.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/sequelcore/kiln/tree/main/packages/cli",
  "keywords": [
    "ai",
    "cli",
    "mcp",
    "claude-code",
    "control-plane"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@kilnai/core": "3.0.0-beta.1",
    "@kilnai/gateway-contracts": "3.0.0-beta.1",
    "@kilnai/gui": "3.0.0-beta.1",
    "@kilnai/runtime": "3.0.0-beta.1",
    "@kilnai/tui": "3.0.0-beta.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "1.16.2",
    "smol-toml": "^1.6.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "yaml": "^2.8.2"
  }
}
