{
  "name": "@kilnai/cli",
  "version": "1.0.7",
  "description": "CLI and MCP surface for the Kiln control plane",
  "type": "module",
  "bin": {
    "kiln": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sequelcore/kiln.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/sequelcore/kiln/tree/main/packages/cli",
  "keywords": [
    "ai",
    "cli",
    "mcp",
    "claude-code",
    "control-plane"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.45",
    "@kilnai/gateway-contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opencode-ai/sdk": "^1.3.9",
    "smol-toml": "^1.6.1",
    "yaml": "^2.8.2"
  },
  "peerDependencies": {
    "@kilnai/core": "^1.0.7",
    "@kilnai/tui": "^1.0.7",
    "@kilnai/runtime": "^1.0.7"
  },
  "devDependencies": {
    "yaml": "^2.8.2"
  }
}
