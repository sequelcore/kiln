{
  "name": "@kilnai/cli",
  "version": "3.0.0-beta.1",
  "description": "CLI and MCP surface for the Kiln control plane",
  "type": "module",
  "bin": {
    "kiln": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "verifiers",
    "README.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/clean-typescript-output.ts && tsc",
    "config:schema:generate": "bun scripts/generate-project-config-artifacts.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=dot --silent=passed-only && bun run test:model-gateway-projection-lock:bun",
    "test:model-gateway-projection-lock:bun": "bun tests/config/global-native-projection-lock.bun.ts",
    "test:verbose": "vitest run --reporter=verbose",
    "test:profile": "bun ../../scripts/run-vitest-profile.ts cli",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sequelcore/kiln.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/sequelcore/kiln/tree/main/packages/cli",
  "keywords": [
    "ai",
    "cli",
    "mcp",
    "claude-code",
    "control-plane"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.237",
    "@kilnai/core": "3.0.0-beta.1",
    "@kilnai/gateway-contracts": "3.0.0-beta.1",
    "@kilnai/gui": "3.0.0-beta.1",
    "@kilnai/runtime": "3.0.0-beta.1",
    "@kilnai/tui": "3.0.0-beta.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "0.147.0",
    "@opencode-ai/sdk": "1.18.18",
    "@sinclair/typebox": "0.34.52",
    "smol-toml": "^1.6.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "yaml": "^2.8.2"
  }
}
