{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.local/schemas/concept-modeling-response-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "concepts", "owner", "affectedSurfaces", "enforcement", "artifacts", "residualUncertainty"],
  "properties": {
    "decision": { "type": "string", "minLength": 1 },
    "concepts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "owner": { "type": "string", "minLength": 1 },
    "affectedSurfaces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "enforcement": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "residualUncertainty": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
