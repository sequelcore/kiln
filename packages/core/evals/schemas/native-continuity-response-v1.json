{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.local/evals/native-continuity-response-v1.schema.json",
  "title": "Kiln Native Continuity Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "preserveUnrelatedBehavior",
    "addCompatibilityLayer",
    "weakenAuthorityBoundary",
    "replanBeforeExpansion",
    "verificationScope",
    "rationale"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "direct-minimal",
        "no-compatibility",
        "stop-replan",
        "focused-verify",
        "preserve-boundary",
        "preserve-unrelated",
        "surface-uncertainty",
        "canonical-projection"
      ]
    },
    "preserveUnrelatedBehavior": { "type": "boolean" },
    "addCompatibilityLayer": { "type": "boolean" },
    "weakenAuthorityBoundary": { "type": "boolean" },
    "replanBeforeExpansion": { "type": "boolean" },
    "verificationScope": { "type": "string", "enum": ["none", "focused", "broad"] },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 400 }
  }
}
