{
  "$id": "https://kiln.dev/schemas/gateway-config-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical schema for gateway.yaml.",
  "properties": {
    "apps": {
      "items": {
        "additionalProperties": false,
        "description": "One deployable App bound into this gateway process.",
        "properties": {
          "channels": {
            "items": {
              "additionalProperties": false,
              "description": "One App Gateway channel binding. Credential material is referenced only by environment-variable name.",
              "properties": {
                "accessTokenEnv": {
                  "pattern": "^[A-Z_][A-Z0-9_]*$",
                  "type": "string",
                  "x-kiln-sensitivity": "secret-reference"
                },
                "adminTokenEnv": {
                  "pattern": "^[A-Z_][A-Z0-9_]*$",
                  "type": "string",
                  "x-kiln-sensitivity": "secret-reference"
                },
                "allowedOrigins": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "apiKeyEnv": {
                  "pattern": "^[A-Z_][A-Z0-9_]*$",
                  "type": "string",
                  "x-kiln-sensitivity": "secret-reference"
                },
                "appSecretEnv": {
                  "pattern": "^[A-Z_][A-Z0-9_]*$",
                  "type": "string",
                  "x-kiln-sensitivity": "secret-reference"
                },
                "multiTenant": {
                  "type": "boolean"
                },
                "path": {
                  "type": "string"
                },
                "phoneNumber": {
                  "type": "string"
                },
                "publicMediaBaseUrlEnv": {
                  "pattern": "^[A-Z_][A-Z0-9_]*$",
                  "type": "string",
                  "x-kiln-sensitivity": "secret-reference"
                },
                "publicMediaSigningSecretEnv": {
                  "pattern": "^[A-Z_][A-Z0-9_]*$",
                  "type": "string",
                  "x-kiln-sensitivity": "secret-reference"
                },
                "type": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "verifyTokenEnv": {
                  "pattern": "^[A-Z_][A-Z0-9_]*$",
                  "type": "string",
                  "x-kiln-sensitivity": "secret-reference"
                }
              },
              "required": [
                "type"
              ],
              "type": "object",
              "x-kiln-authority-impact": "authority-bearing",
              "x-kiln-semantic-owner": "app-gateway-channel-binding",
              "x-kiln-sensitivity": "public"
            },
            "minItems": 1,
            "type": "array"
          },
          "config": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "workspace": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "name",
          "config",
          "channels"
        ],
        "type": "object",
        "x-kiln-authority-impact": "authority-bearing",
        "x-kiln-semantic-owner": "app-gateway-runtime"
      },
      "type": "array"
    },
    "auth": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "anyOf": [
            {
              "const": "RS256",
              "type": "string"
            },
            {
              "const": "HS256",
              "type": "string"
            }
          ]
        },
        "audience": {
          "type": "string"
        },
        "clockToleranceSeconds": {
          "minimum": 0,
          "type": "integer"
        },
        "issuer": {
          "type": "string"
        },
        "jwksUri": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "secretEnv": {
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "type": "string",
          "x-kiln-sensitivity": "secret-reference"
        }
      },
      "required": [
        "algorithm"
      ],
      "type": "object",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "gateway-authentication"
    },
    "mcp": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "additionalProperties": false,
          "properties": {
            "keyEnv": {
              "pattern": "^[A-Z_][A-Z0-9_]*$",
              "type": "string",
              "x-kiln-sensitivity": "secret-reference"
            },
            "type": {
              "anyOf": [
                {
                  "const": "api-key",
                  "type": "string"
                },
                {
                  "const": "none",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "type"
          ],
          "type": "object",
          "x-kiln-authority-impact": "authority-bearing"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "gateway-mcp"
    },
    "modelGateway": {
      "additionalProperties": false,
      "properties": {
        "codexComposite": {
          "additionalProperties": false,
          "properties": {
            "maxQueuedRequests": {
              "maximum": 4096,
              "minimum": 0,
              "type": "integer"
            },
            "queueTimeoutMs": {
              "maximum": 300000,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "maxQueuedRequests",
            "queueTimeoutMs"
          ],
          "type": "object"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "principals": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "applicationId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                "type": "string"
              },
              "budgetEvidenceId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                "type": "string"
              },
              "callerId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                "type": "string"
              },
              "capabilityId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                "type": "string"
              },
              "ingress": {
                "anyOf": [
                  {
                    "const": "openai-responses",
                    "type": "string"
                  },
                  {
                    "const": "anthropic-messages",
                    "type": "string"
                  }
                ]
              },
              "nativeHarness": {
                "anyOf": [
                  {
                    "const": "codex",
                    "type": "string"
                  },
                  {
                    "const": "opencode",
                    "type": "string"
                  },
                  {
                    "const": "claude",
                    "type": "string"
                  }
                ]
              },
              "scopes": {
                "items": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "tenantId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                "type": "string"
              },
              "tokenEnv": {
                "pattern": "^[A-Z_][A-Z0-9_]*$",
                "type": "string",
                "x-kiln-sensitivity": "secret-reference"
              },
              "virtualModelIds": {
                "items": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "tokenEnv",
              "ingress",
              "tenantId",
              "applicationId",
              "callerId",
              "capabilityId",
              "scopes",
              "budgetEvidenceId",
              "virtualModelIds"
            ],
            "type": "object",
            "x-kiln-authority-impact": "authority-bearing"
          },
          "minItems": 1,
          "type": "array"
        },
        "replay": {
          "additionalProperties": false,
          "properties": {
            "hmacKeyEnv": {
              "pattern": "^[A-Z_][A-Z0-9_]*$",
              "type": "string",
              "x-kiln-sensitivity": "secret-reference"
            },
            "maxEntries": {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            "ttlMs": {
              "maximum": 86400000,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "ttlMs",
            "maxEntries",
            "hmacKeyEnv"
          ],
          "type": "object"
        },
        "surfaces": {
          "additionalProperties": false,
          "properties": {
            "anthropicMessages": {
              "additionalProperties": false,
              "properties": {
                "maxBodyBytes": {
                  "maximum": 67108864,
                  "minimum": 1,
                  "type": "integer"
                },
                "maxConcurrentRequests": {
                  "maximum": 1024,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "maxBodyBytes",
                "maxConcurrentRequests"
              ],
              "type": "object"
            },
            "openAIResponses": {
              "additionalProperties": false,
              "properties": {
                "maxBodyBytes": {
                  "maximum": 67108864,
                  "minimum": 1,
                  "type": "integer"
                },
                "maxConcurrentRequests": {
                  "maximum": 1024,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "maxBodyBytes",
                "maxConcurrentRequests"
              ],
              "type": "object"
            }
          },
          "type": "object"
        },
        "virtualModels": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "affinity": {
                "additionalProperties": false,
                "properties": {
                  "allowRebind": {
                    "type": "boolean"
                  },
                  "continuity": {
                    "anyOf": [
                      {
                        "const": "none",
                        "type": "string"
                      },
                      {
                        "const": "prefer",
                        "type": "string"
                      },
                      {
                        "const": "require",
                        "type": "string"
                      }
                    ]
                  },
                  "scope": {
                    "anyOf": [
                      {
                        "const": "session",
                        "type": "string"
                      },
                      {
                        "const": "turn",
                        "type": "string"
                      }
                    ]
                  }
                },
                "required": [
                  "continuity"
                ],
                "type": "object"
              },
              "baseInstructions": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "capabilities": {
                "items": {
                  "anyOf": [
                    {
                      "const": "text",
                      "type": "string"
                    },
                    {
                      "const": "input-image-url",
                      "type": "string"
                    },
                    {
                      "const": "input-image-base64",
                      "type": "string"
                    },
                    {
                      "const": "function-tools",
                      "type": "string"
                    },
                    {
                      "const": "custom-tools-lark",
                      "type": "string"
                    },
                    {
                      "const": "parallel-tool-calls",
                      "type": "string"
                    },
                    {
                      "const": "json-schema-response",
                      "type": "string"
                    },
                    {
                      "const": "reasoning-controls",
                      "type": "string"
                    },
                    {
                      "const": "text-verbosity",
                      "type": "string"
                    }
                  ]
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "contextTokens": {
                "minimum": 1,
                "type": "integer"
              },
              "deliberation": {
                "additionalProperties": false,
                "properties": {
                  "defaultLevel": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                    "type": "string"
                  },
                  "evidenceRevision": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                    "type": "string"
                  },
                  "levels": {
                    "items": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "supportsAdaptive": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "levels",
                  "supportsAdaptive",
                  "evidenceRevision"
                ],
                "type": "object"
              },
              "displayName": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                "type": "string"
              },
              "outputTokens": {
                "minimum": 1,
                "type": "integer"
              },
              "targetId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "targetId",
              "capabilities",
              "affinity"
            ],
            "type": "object",
            "x-kiln-authority-impact": "authority-bearing"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "port",
        "replay",
        "principals",
        "virtualModels",
        "surfaces"
      ],
      "type": "object",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "model-gateway"
    },
    "observability": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "patternProperties": {
            "\\S": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "exporter": {
          "anyOf": [
            {
              "const": "otlp",
              "type": "string"
            },
            {
              "const": "console",
              "type": "string"
            },
            {
              "const": "none",
              "type": "string"
            }
          ],
          "default": "none"
        },
        "serviceName": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "exporter",
        "serviceName"
      ],
      "type": "object",
      "x-kiln-authority-impact": "none",
      "x-kiln-semantic-owner": "gateway-observability"
    },
    "port": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "port",
    "apps"
  ],
  "title": "Kiln gateway configuration",
  "type": "object",
  "x-kiln-activation": "restart-required",
  "x-kiln-authority-impact": "authority-bearing",
  "x-kiln-default-posture": "omitted",
  "x-kiln-schema-revision": 1,
  "x-kiln-scope": "gateway",
  "x-kiln-semantic-owner": "app-gateway-runtime",
  "x-kiln-sensitivity": "public",
  "x-kiln-structural-owner": "gateway-configuration"
}
