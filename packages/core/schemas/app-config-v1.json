{
  "$id": "https://kiln.dev/schemas/app-config-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical structural schema for app.yaml.",
  "properties": {
    "billing": {
      "additionalProperties": false,
      "properties": {
        "budgetEndpoint": {},
        "headers": {
          "patternProperties": {
            "^(.*)$": {
              "pattern": "^\\$[A-Z_][A-Z0-9_]*$",
              "type": "string"
            }
          },
          "type": "object",
          "x-kiln-sensitivity": "secret-reference"
        },
        "overBudgetMessage": {},
        "tiers": {
          "patternProperties": {
            "^(.*)$": {
              "additionalProperties": false,
              "properties": {
                "agents": {}
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "provider-adapter-runtime"
    },
    "mcp": {
      "additionalProperties": false,
      "properties": {
        "servers": {}
      },
      "type": "object",
      "x-kiln-semantic-owner": "app-mcp"
    },
    "name": {},
    "provider": {
      "additionalProperties": false,
      "properties": {
        "apiKeyEnv": {
          "x-kiln-sensitivity": "secret-reference"
        },
        "model": {},
        "name": {}
      },
      "type": "object",
      "x-kiln-authority-impact": "authority-bearing",
      "x-kiln-semantic-owner": "provider-adapter-runtime"
    },
    "router": {
      "additionalProperties": false,
      "properties": {
        "fallback": {}
      },
      "type": "object",
      "x-kiln-semantic-owner": "router"
    },
    "runtime": {},
    "safety": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "additionalProperties": false,
          "properties": {
            "categories": {
              "patternProperties": {
                "^(.*)$": {
                  "additionalProperties": false,
                  "properties": {
                    "action": {},
                    "threshold": {}
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "enabled": {}
          },
          "type": "object"
        },
        "pii": {
          "additionalProperties": false,
          "properties": {
            "action": {},
            "allowlist": {},
            "detect": {}
          },
          "type": "object"
        },
        "rails": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "block": {},
              "competitors": {},
              "escalate": {},
              "forbid": {},
              "required": {},
              "response": {},
              "triggers": {},
              "type": {}
            },
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object",
      "x-kiln-semantic-owner": "safety"
    },
    "teams": {
      "patternProperties": {
        "^(.*)$": {
          "additionalProperties": false,
          "properties": {
            "agents": {
              "patternProperties": {
                "^(.*)$": {
                  "additionalProperties": false,
                  "properties": {
                    "backstory": {},
                    "goal": {},
                    "instructions": {},
                    "name": {},
                    "role": {},
                    "tools": {}
                  },
                  "type": "object",
                  "x-kiln-semantic-owner": "agent"
                }
              },
              "type": "object"
            },
            "capabilities": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "description": {},
                  "effectEnvelope": {
                    "additionalProperties": false,
                    "properties": {
                      "boundaries": {},
                      "consequences": {},
                      "dataEgress": {},
                      "idempotency": {},
                      "identityUse": {},
                      "operation": {},
                      "reversibility": {}
                    },
                    "type": "object",
                    "x-kiln-semantic-owner": "action-effect"
                  },
                  "guardrail": {},
                  "guardrailRetries": {},
                  "name": {},
                  "outputSchema": {},
                  "retry": {
                    "additionalProperties": false,
                    "properties": {
                      "fallback": {},
                      "maxAttempts": {},
                      "onTransientError": {},
                      "onValidationError": {},
                      "timeout": {}
                    },
                    "type": "object"
                  },
                  "schema": {},
                  "tags": {},
                  "targetApp": {},
                  "task": {},
                  "timeout": {},
                  "type": {}
                },
                "type": "object",
                "x-kiln-semantic-owner": "capability"
              },
              "type": "array"
            },
            "manager": {}
          },
          "type": "object",
          "x-kiln-semantic-owner": "team"
        }
      },
      "type": "object"
    },
    "triggers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cron": {},
          "enabled": {},
          "event": {},
          "filter": {},
          "method": {},
          "name": {},
          "path": {},
          "secretEnv": {
            "x-kiln-sensitivity": "secret-reference"
          },
          "task": {},
          "team": {},
          "timezone": {},
          "type": {}
        },
        "type": "object",
        "x-kiln-semantic-owner": "trigger"
      },
      "type": "array"
    },
    "voice": {
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "additionalProperties": false,
          "properties": {
            "ttsProfile": {}
          },
          "type": "object"
        },
        "policy": {
          "additionalProperties": false,
          "properties": {
            "artifacts": {
              "additionalProperties": false,
              "properties": {
                "retentionMaxArtifacts": {},
                "storeSourceAudio": {},
                "storeSynthesizedAudio": {},
                "storeTranscripts": {}
              },
              "type": "object"
            },
            "defaultInputFailureMode": {},
            "defaultOutputFailureMode": {},
            "surfaces": {
              "patternProperties": {
                "^(.*)$": {
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {},
                    "input": {
                      "additionalProperties": false,
                      "properties": {
                        "failureMode": {},
                        "modes": {}
                      },
                      "type": "object"
                    },
                    "output": {
                      "additionalProperties": false,
                      "properties": {
                        "failureMode": {},
                        "modes": {}
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "stt": {
          "additionalProperties": false,
          "properties": {
            "apiKeyEnv": {
              "x-kiln-sensitivity": "secret-reference"
            },
            "args": {},
            "command": {},
            "commandEnv": {
              "x-kiln-sensitivity": "secret-reference"
            },
            "device": {},
            "language": {},
            "model": {},
            "modelPath": {},
            "modelPathEnv": {
              "x-kiln-sensitivity": "secret-reference"
            },
            "provider": {},
            "timeoutMs": {}
          },
          "type": "object"
        },
        "tts": {
          "additionalProperties": false,
          "properties": {
            "apiKeyEnv": {
              "x-kiln-sensitivity": "secret-reference"
            },
            "args": {},
            "command": {},
            "commandEnv": {
              "x-kiln-sensitivity": "secret-reference"
            },
            "device": {},
            "format": {},
            "model": {},
            "modelPath": {},
            "modelPathEnv": {
              "x-kiln-sensitivity": "secret-reference"
            },
            "provider": {},
            "timeoutMs": {},
            "voice": {}
          },
          "type": "object"
        },
        "ttsProfiles": {
          "patternProperties": {
            "^(.*)$": {
              "additionalProperties": false,
              "properties": {
                "format": {},
                "intents": {
                  "patternProperties": {
                    "^(.*)$": {
                      "additionalProperties": false,
                      "properties": {
                        "appliesWhen": {},
                        "delivery": {},
                        "format": {},
                        "language": {},
                        "speed": {},
                        "voice": {}
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                "language": {},
                "speed": {},
                "speedRange": {},
                "style": {},
                "voice": {}
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object",
      "x-kiln-semantic-owner": "voice"
    }
  },
  "required": [
    "name",
    "router",
    "teams"
  ],
  "title": "Kiln app configuration",
  "type": "object",
  "x-kiln-activation": "restart-required",
  "x-kiln-authority-impact": "authority-bearing",
  "x-kiln-default-posture": "omitted",
  "x-kiln-schema-revision": 1,
  "x-kiln-scope": "app",
  "x-kiln-semantic-owner": "app-domain",
  "x-kiln-sensitivity": "public",
  "x-kiln-structural-owner": "app-configuration"
}
