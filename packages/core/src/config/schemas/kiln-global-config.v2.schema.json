{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiln.ai/schemas/kiln-global-config.v2.schema.json",
  "title": "KilnGlobalConfig v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": "2" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "timezone": { "type": "string" }
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "billing": {
            "enum": ["subscription", "plus-quota", "free", "api-key", "local"]
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultWorker": { "type": "string" },
        "fallback": { "type": "string" },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider"],
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "model": { "type": "string" }
            }
          }
        },
        "budgetAware": { "type": "boolean" },
        "budget": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dailyTokenCeiling": { "type": ["number", "null"] },
              "onCeiling": { "enum": ["fallback", "stop"] }
            }
          }
        }
      }
    },
    "permissions": { "type": "object" },
    "mcp": { "type": "object" },
    "hooks": { "type": "object" },
    "agents": {
      "type": "array",
      "items": { "type": "object" }
    },
    "skills": {
      "type": "array",
      "items": { "type": "object" }
    },
    "models": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "managedAgents": { "type": "object" },
    "web": { "type": "object" },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": { "type": "string" }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
