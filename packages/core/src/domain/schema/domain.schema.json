{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kiln.dev/schemas/domain.schema.json",
  "title": "Kiln Domain Configuration",
  "description": "Schema for domain.yaml files that configure tech stack detection, quality gates, and tool filtering.",
  "type": "object",
  "required": ["name", "displayName", "detectPatterns", "toolTags", "qualityGates"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique identifier for the domain (e.g., 'python', 'react-ts')"
    },
    "displayName": {
      "type": "string",
      "description": "Human-readable name (e.g., 'Python', 'React / TypeScript')"
    },
    "detectPatterns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "File patterns that identify this domain (e.g., 'pyproject.toml', 'tsconfig.json')"
    },
    "toolTags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tags for filtering MCP tools available to agents in this domain"
    },
    "qualityGates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command", "description"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Gate identifier (e.g., 'lint', 'tests', 'types')"
          },
          "command": {
            "type": "string",
            "description": "Shell command to execute (e.g., 'pytest', 'tsc --noEmit')"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of what this gate checks"
          },
          "required": {
            "type": "boolean",
            "default": true,
            "description": "Whether this gate must pass (default: true)"
          }
        }
      },
      "description": "Quality gates that must pass during verification"
    },
    "multishotExamples": {
      "type": "string",
      "default": "",
      "description": "Few-shot examples for agent learning (XML format)"
    },
    "phaseExamples": {
      "type": "string",
      "default": "",
      "description": "Phase-specific guidance for agents (XML format)"
    },
    "version": {
      "type": "string",
      "description": "Package version (semver, e.g., '1.0.0')"
    },
    "author": {
      "type": "string",
      "description": "Package author name or email"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to skill markdown files (e.g., 'skills/create-routine.md')"
    },
    "tools": {
      "type": "object",
      "required": ["server"],
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "string",
          "description": "Path to MCP server entry point (e.g., 'tools/server.ts')"
        }
      },
      "description": "MCP server tools configuration"
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "examples": {
          "type": "string",
          "description": "Path to multishot examples file (e.g., 'knowledge/examples.yaml')"
        },
        "gates": {
          "type": "string",
          "description": "Path to quality gate definitions file (e.g., 'knowledge/gates.yaml')"
        }
      },
      "description": "Knowledge file references for the domain package"
    }
  }
}
