{
  "name": "@kilnai/widget",
  "version": "3.0.0-beta.1",
  "description": "Embeddable chat widget for apps built on the Kiln control plane",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "unpkg": "./dist/widget.iife.js",
  "jsdelivr": "./dist/widget.iife.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sequelcore/kiln.git",
    "directory": "packages/widget"
  },
  "homepage": "https://github.com/sequelcore/kiln/tree/main/packages/widget",
  "keywords": [
    "kiln",
    "widget",
    "chat",
    "web-component"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kilnai/gateway-contracts": "3.0.0-beta.1"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "vitest": "^4.1.9"
  }
}
