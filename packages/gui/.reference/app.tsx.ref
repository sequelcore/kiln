import {
  startTransition,
  useCallback,
  useEffect,
  useMemo,
  useRef,
  useState,
  type KeyboardEvent as ReactKeyboardEvent,
  type ReactElement,
} from "react";
import {
  GuiGatewayClient,
  type GuiDashboardSnapshot,
  type GuiInboundFrame,
  type GuiProviderDescriptor,
  type GuiSessionClient,
  type GuiSessionConnectionState,
  type GuiSessionSummary,
} from "./api/client.js";

type ThemeMode = "kiln-dark" | "kiln-light" | "system";
type CommandId = "new-session" | "provider" | "theme" | "clear" | "resume";
type TranscriptRole = "assistant" | "system" | "user" | "activity" | "error";

interface CommandItem {
  readonly id: CommandId;
  readonly label: string;
  readonly description: string;
}

interface TranscriptMessage {
  readonly id: string;
  readonly role: TranscriptRole;
  readonly title: string;
  readonly body: string;
  readonly pending?: boolean;
}

interface ResumeSelection {
  readonly sessionId: string;
  readonly provider: string;
  readonly title: string;
}

const COMMANDS: readonly CommandItem[] = [
  { id: "new-session", label: "New Session", description: "Reset transcript state and clear runtime session." },
  { id: "provider", label: "Next Provider", description: "Cycle to the next available provider." },
  { id: "resume", label: "Resume Session", description: "Set the selected history row as next-turn resume target." },
  { id: "theme", label: "Toggle Theme", description: "Rotate dark, light, and system themes." },
  { id: "clear", label: "Clear Session", description: "Request a clear-session frame over gateway transport." },
];

const THEME_STORAGE_KEY = "kiln.gui.theme";

export function App(): ReactElement {
  const client = useMemo(() => new GuiGatewayClient(), []);
  const sessionClientRef = useRef<GuiSessionClient | null>(null);
  const pendingAssistantIdRef = useRef<string | null>(null);
  const pendingResumeRef = useRef<ResumeSelection | null>(null);
  const transcriptEndRef = useRef<HTMLDivElement | null>(null);

  const [snapshot, setSnapshot] = useState<GuiDashboardSnapshot | null>(null);
  const [loading, setLoading] = useState(true);
  const [commandOpen, setCommandOpen] = useState(false);
  const [theme, setTheme] = useState<ThemeMode>(readInitialTheme);
  const [messages, setMessages] = useState<readonly TranscriptMessage[]>(() => createInitialTranscript());
  const [composerValue, setComposerValue] = useState("");
  const [running, setRunning] = useState(false);
  const [clearing, setClearing] = useState(false);
  const [connectionState, setConnectionState] = useState<GuiSessionConnectionState>("disconnected");
  const [transportError, setTransportError] = useState<string | null>(null);
  const [activeProvider, setActiveProvider] = useState<string | null>(null);
  const [selectedSessionId, setSelectedSessionId] = useState<string | null>(null);
  const [resumeSelection, setResumeSelection] = useState<ResumeSelection | null>(null);
  const [resuming, setResuming] = useState(false);

  const appendMessage = useCallback((message: TranscriptMessage): void => {
    setMessages((current) => [...current, message]);
  }, []);

  const upsertPendingAssistant = useCallback((fallbackBody: string): string => {
    const pendingId = pendingAssistantIdRef.current;
    if (pendingId) {
      setMessages((current) =>
        current.map((message) =>
          message.id === pendingId
            ? {
                ...message,
                body: message.body.length > 0 ? message.body : fallbackBody,
                pending: true,
              }
            : message,
        ),
      );
      return pendingId;
    }

    const nextId = createLocalId();
    pendingAssistantIdRef.current = nextId;
    appendMessage({
      id: nextId,
      role: "assistant",
      title: "Assistant",
      body: fallbackBody,
      pending: true,
    });
    return nextId;
  }, [appendMessage]);

  const handleInboundFrame = useCallback((frame: GuiInboundFrame): void => {
    if (frame.type === "welcome") {
      const providerIds = frame.models ? Object.keys(frame.models) : [];
      if (providerIds.length > 0) {
        setActiveProvider((current) => current ?? providerIds[0] ?? null);
      }
      return;
    }

    if (frame.type === "thinking") {
      upsertPendingAssistant("Thinking...");
      setRunning(true);
      return;
    }

    if (frame.type === "text_delta") {
      const pendingId = upsertPendingAssistant("");
      setMessages((current) =>
        current.map((message) =>
          message.id === pendingId
            ? {
                ...message,
                body: `${message.body}${frame.content}`,
                pending: true,
              }
            : message,
        ),
      );
      setRunning(true);
      return;
    }

    if (frame.type === "activity") {
      appendMessage({
        id: createLocalId(),
        role: "activity",
        title: "Activity",
        body: formatActivity(frame),
      });
      return;
    }

    if (frame.type === "done") {
      const pendingId = pendingAssistantIdRef.current;
      if (pendingId) {
        setMessages((current) =>
          current.map((message) =>
            message.id === pendingId
              ? {
                  ...message,
                  body: frame.content.trim().length > 0 ? frame.content : message.body || "Completed.",
                  pending: false,
                }
              : message,
          ),
        );
      } else if (frame.content.trim().length > 0) {
        appendMessage({
          id: createLocalId(),
          role: "assistant",
          title: "Assistant",
          body: frame.content,
        });
      }
      if (frame.routedProvider) {
        setActiveProvider(frame.routedProvider);
      }
      pendingAssistantIdRef.current = null;
      setResumeSelection(null);
      pendingResumeRef.current = null;
      setRunning(false);
      return;
    }

    if (frame.type === "error") {
      const pendingId = pendingAssistantIdRef.current;
      if (pendingId) {
        setMessages((current) =>
          current.map((message) =>
            message.id === pendingId
              ? {
                  ...message,
                  role: "error",
                  title: "Error",
                  body: frame.message,
                  pending: false,
                }
              : message,
          ),
        );
      } else {
        appendMessage({
          id: createLocalId(),
          role: "error",
          title: "Error",
          body: frame.message,
        });
      }
      pendingAssistantIdRef.current = null;
      pendingResumeRef.current = null;
      setTransportError(frame.message);
      setRunning(false);
      setClearing(false);
      setResuming(false);
      return;
    }

    if (frame.type === "cleared") {
      pendingAssistantIdRef.current = null;
      pendingResumeRef.current = null;
      setMessages(createInitialTranscript());
      setComposerValue("");
      setResumeSelection(null);
      setTransportError(null);
      setRunning(false);
      setClearing(false);
      setResuming(false);
      return;
    }

    if (frame.type === "provider_changed") {
      setActiveProvider(frame.provider);
      setResumeSelection((current) => (current && current.provider !== frame.provider ? null : current));
      appendMessage({
        id: createLocalId(),
        role: "system",
        title: "Provider",
        body: `Provider switched to ${frame.provider}.`,
      });
      return;
    }

    if (frame.type === "resume_selected") {
      const pending = pendingResumeRef.current;
      const title =
        pending && pending.sessionId === frame.sessionId
          ? pending.title
          : `Session ${formatSessionId(frame.sessionId)}`;
      setActiveProvider(frame.provider);
      setResumeSelection({
        sessionId: frame.sessionId,
        provider: frame.provider,
        title,
      });
      appendMessage({
        id: createLocalId(),
        role: "system",
        title: "Resume",
        body: `Next turn will continue "${title}" on ${frame.provider}.`,
      });
      pendingResumeRef.current = null;
      setTransportError(null);
      setResuming(false);
      return;
    }

    if (frame.type === "approval_requested") {
      appendMessage({
        id: createLocalId(),
        role: "activity",
        title: "Approval Requested",
        body: frame.description,
      });
      return;
    }

    if (frame.type === "approval_received") {
      appendMessage({
        id: createLocalId(),
        role: "activity",
        title: frame.approved ? "Approval Granted" : "Approval Rejected",
        body: frame.reason ?? (frame.approved ? "Approved." : "Rejected."),
      });
      return;
    }

    if (frame.type === "exec_confirmed") {
      appendMessage({
        id: createLocalId(),
        role: "system",
        title: "Execution",
        body: "Plan mode execution confirmed.",
      });
    }
  }, [appendMessage, upsertPendingAssistant]);

  useEffect(() => {
    const session = client.createSessionClient({
      onFrame: handleInboundFrame,
      onConnectionStateChange: (next) => setConnectionState(next),
      onError: (error) => setTransportError(error.message),
    });

    sessionClientRef.current = session;
    session.connect();

    return () => {
      session.disconnect();
      sessionClientRef.current = null;
    };
  }, [client, handleInboundFrame]);

  useEffect(() => {
    let cancelled = false;

    const refresh = async (): Promise<void> => {
      const nextSnapshot = await client.loadDashboard();
      if (cancelled) {
        return;
      }

      startTransition(() => {
        setSnapshot(nextSnapshot);
        setLoading(false);
        setActiveProvider((current) => current ?? nextSnapshot.providers.find((provider) => provider.available)?.id ?? null);
      });
    };

    void refresh();
    const interval = window.setInterval(() => {
      void refresh();
    }, 2_000);

    return () => {
      cancelled = true;
      window.clearInterval(interval);
    };
  }, [client]);

  useEffect(() => {
    writeTheme(theme);
    document.documentElement.dataset.theme = resolveTheme(theme);
  }, [theme]);

  useEffect(() => {
    const onKeyDown = (event: KeyboardEvent): void => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        setCommandOpen((current) => !current);
        return;
      }

      if (event.key === "Escape") {
        setCommandOpen(false);
        return;
      }

      if (event.key === "/" && !event.ctrlKey && !event.metaKey && !event.altKey) {
        const target = event.target as HTMLElement | null;
        const editing =
          target instanceof HTMLInputElement ||
          target instanceof HTMLTextAreaElement ||
          target?.isContentEditable === true;
        if (!editing) {
          event.preventDefault();
          setCommandOpen(true);
        }
      }
    };

    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, []);

  useEffect(() => {
    transcriptEndRef.current?.scrollIntoView({ behavior: "smooth", block: "end" });
  }, [messages]);

  const providers = snapshot?.providers ?? [];
  const sessions = snapshot?.sessions ?? [];
  const telemetry = snapshot?.telemetry;

  useEffect(() => {
    if (sessions.length === 0) {
      setSelectedSessionId(null);
      return;
    }

    setSelectedSessionId((current) =>
      current && sessions.some((session) => session.id === current) ? current : sessions[0]?.id ?? null,
    );
  }, [sessions]);

  const selectedSession = sessions.find((session) => session.id === selectedSessionId) ?? sessions[0] ?? null;
  const resumeActionDisabled = connectionState !== "connected" || running || clearing || resuming;
  const sendDisabled =
    composerValue.trim().length === 0 || running || resuming || connectionState !== "connected";

  const submitPrompt = useCallback((): void => {
    const prompt = composerValue.trim();
    if (prompt.length === 0 || running) {
      return;
    }

    const session = sessionClientRef.current;
    if (!session) {
      setTransportError("GUI session client is not available.");
      return;
    }

    const userMessage: TranscriptMessage = {
      id: createLocalId(),
      role: "user",
      title: "You",
      body: prompt,
    };
    const pendingAssistantId = createLocalId();
    const pendingAssistant: TranscriptMessage = {
      id: pendingAssistantId,
      role: "assistant",
      title: "Assistant",
      body: "",
      pending: true,
    };

    pendingAssistantIdRef.current = pendingAssistantId;
    setMessages((current) => [...current, userMessage, pendingAssistant]);
    setComposerValue("");
    setTransportError(null);
    setRunning(true);

    try {
      session.sendMessage(prompt);
      setResumeSelection(null);
      pendingResumeRef.current = null;
    } catch (error) {
      const reason = toErrorMessage(error, "Unable to send prompt.");
      setMessages((current) =>
        current.map((message) =>
          message.id === pendingAssistantId
            ? {
                ...message,
                role: "error",
                title: "Error",
                body: reason,
                pending: false,
              }
            : message,
        ),
      );
      pendingAssistantIdRef.current = null;
      setTransportError(reason);
      setRunning(false);
    }
  }, [composerValue, running]);

  const clearSession = useCallback(async (): Promise<void> => {
    const session = sessionClientRef.current;
    if (!session || clearing) {
      return;
    }

    setTransportError(null);
    setClearing(true);
    try {
      await session.clearSession();
    } catch (error) {
      const reason = toErrorMessage(error, "Unable to clear the current session.");
      setTransportError(reason);
      appendMessage({
        id: createLocalId(),
        role: "error",
        title: "Error",
        body: reason,
      });
      setClearing(false);
    }
  }, [appendMessage, clearing]);

  const switchProvider = useCallback(async (providerId: string): Promise<void> => {
    const session = sessionClientRef.current;
    if (!session) {
      setTransportError("GUI session client is not available.");
      return;
    }

    setTransportError(null);
    try {
      await session.switchProvider(providerId);
    } catch (error) {
      const reason = toErrorMessage(error, `Unable to switch provider to ${providerId}.`);
      setTransportError(reason);
      appendMessage({
        id: createLocalId(),
        role: "error",
        title: "Error",
        body: reason,
      });
    }
  }, [appendMessage]);

  const resumeSession = useCallback(async (sessionSummary: GuiSessionSummary): Promise<void> => {
    const session = sessionClientRef.current;
    if (!session) {
      setTransportError("GUI session client is not available.");
      return;
    }

    if (resumeActionDisabled) {
      return;
    }

    pendingResumeRef.current = {
      sessionId: sessionSummary.id,
      provider: sessionSummary.provider,
      title: sessionSummary.title,
    };
    setTransportError(null);
    setResuming(true);

    try {
      await session.selectResumeSession(sessionSummary.id, sessionSummary.provider);
    } catch (error) {
      const reason = toErrorMessage(error, "Unable to select a session resume target.");
      pendingResumeRef.current = null;
      setTransportError(reason);
      appendMessage({
        id: createLocalId(),
        role: "error",
        title: "Error",
        body: reason,
      });
      setResuming(false);
    }
  }, [appendMessage, resumeActionDisabled]);

  const handleComposerKeyDown = useCallback((event: ReactKeyboardEvent<HTMLTextAreaElement>): void => {
    if (event.key === "Enter" && !event.shiftKey) {
      event.preventDefault();
      if (composerValue.trim().length === 0 && selectedSession) {
        if (!resumeActionDisabled) {
          void resumeSession(selectedSession);
        }
        return;
      }
      submitPrompt();
    }
  }, [composerValue, resumeActionDisabled, resumeSession, selectedSession, submitPrompt]);

  const rotateTheme = useCallback((): void => {
    setTheme((current) => {
      if (current === "kiln-dark") {
        return "kiln-light";
      }
      if (current === "kiln-light") {
        return "system";
      }
      return "kiln-dark";
    });
  }, []);

  const runCommand = useCallback((commandId: CommandId): void => {
    setCommandOpen(false);
    if (commandId === "new-session" || commandId === "clear") {
      void clearSession();
      return;
    }

    if (commandId === "theme") {
      rotateTheme();
      return;
    }

    if (commandId === "resume") {
      if (!selectedSession) {
        setTransportError("No session selected to resume.");
        return;
      }
      void resumeSession(selectedSession);
      return;
    }

    const available = providers.filter((provider) => provider.available);
    if (available.length === 0) {
      setTransportError("No available providers to switch.");
      return;
    }

    const currentIndex = available.findIndex((provider) => provider.id === activeProvider);
    const nextIndex = currentIndex >= 0 ? (currentIndex + 1) % available.length : 0;
    const nextProvider = available[nextIndex];
    if (nextProvider) {
      void switchProvider(nextProvider.id);
    }
  }, [activeProvider, clearSession, providers, resumeSession, rotateTheme, selectedSession, switchProvider]);

  return (
    <div className="gui-shell">
      <aside className="rail">
        <div className="brand-block">
          <p className="eyebrow">Kiln GUI</p>
          <h1>Operator Surface</h1>
          <p className="muted">Gateway-backed session transport with dashboard polling.</p>
        </div>

        <section className="panel">
          <div className="panel-heading">
            <h2>Providers</h2>
            <span className="badge">{providers.length}</span>
          </div>
          <ProviderList
            providers={providers}
            activeProvider={activeProvider}
            onSwitch={(providerId) => void switchProvider(providerId)}
          />
        </section>

        <section className="panel">
          <div className="panel-heading">
            <h2>Theme</h2>
          </div>
          <div className="theme-toggle">
            <ThemeButton active={theme === "kiln-dark"} onClick={() => setTheme("kiln-dark")} label="Dark" />
            <ThemeButton active={theme === "kiln-light"} onClick={() => setTheme("kiln-light")} label="Light" />
            <ThemeButton active={theme === "system"} onClick={() => setTheme("system")} label="System" />
          </div>
        </section>
      </aside>

      <main className="workspace">
        <header className="topbar">
          <div>
            <p className="eyebrow">Session Transport</p>
            <h2>Gateway Stream</h2>
          </div>
          <div className="topbar-actions">
            <span className={`status-pill ${connectionState}`}>
              {formatConnectionState(connectionState)}
            </span>
            <button className="command-button" type="button" onClick={() => setCommandOpen(true)}>
              Cmd/Ctrl + K
            </button>
          </div>
        </header>

        <section className="hero panel">
          <div>
            <p className="eyebrow">Runtime State</p>
            <h3>Connect, send prompts, and receive transcript frames over `/gui/ws`</h3>
          </div>
          <p className="muted">
            {resumeSelection
              ? `Next turn resumes ${formatSessionId(resumeSelection.sessionId)} on ${resumeSelection.provider}.`
              : running
                ? "Turn running..."
                : resuming
                  ? "Selecting resume target..."
                  : loading
                    ? "Loading dashboard..."
                    : "Ready for input."}
          </p>
        </section>

        <div className="workspace-grid">
          <section className="panel transcript-panel">
            <div className="panel-heading transcript-toolbar">
              <h2>Transcript</h2>
              <div className="toolbar-actions">
                <span className={`badge subtle ${running ? "running" : ""}`}>{running ? "Running" : "Idle"}</span>
                <button
                  className="theme-button"
                  type="button"
                  onClick={() => void clearSession()}
                  disabled={clearing || connectionState !== "connected"}
                >
                  {clearing ? "Clearing..." : "Clear"}
                </button>
              </div>
            </div>

            <div className="transcript" aria-live="polite" aria-label="Session transcript">
              {messages.map((message) => (
                <MessageBubble
                  key={message.id}
                  role={message.role}
                  title={message.title}
                  body={message.body}
                  pending={message.pending}
                />
              ))}
              <div ref={transcriptEndRef} />
            </div>

            {transportError ? (
              <p className="alert" role="alert">{transportError}</p>
            ) : null}

            <div className="composer">
              <textarea
                className="composer-input"
                rows={4}
                value={composerValue}
                onChange={(event) => setComposerValue(event.target.value)}
                onKeyDown={handleComposerKeyDown}
                placeholder="Type a prompt. Enter sends, empty Enter resumes selected session, Shift+Enter inserts a newline."
                disabled={connectionState !== "connected"}
              />
              <div className="composer-actions">
                <span className="muted">Enter sends. Empty Enter resumes selection. Shift+Enter inserts a newline.</span>
                <button className="primary-button" type="button" onClick={submitPrompt} disabled={sendDisabled}>
                  {running ? "Running..." : "Send"}
                </button>
              </div>
            </div>
          </section>

          <section className="stack">
            <section className="panel">
              <div className="panel-heading">
                <h2>Recent Sessions</h2>
                <div className="toolbar-actions">
                  <span className="badge subtle">{sessions.length}</span>
                  <button
                    className="theme-button"
                    type="button"
                    onClick={() => selectedSession ? void resumeSession(selectedSession) : undefined}
                    disabled={!selectedSession || resumeActionDisabled}
                  >
                    {resuming ? "Resuming..." : "Resume"}
                  </button>
                </div>
              </div>
              <p className="muted session-hint">Arrow keys select. Empty Enter resumes the selected session.</p>
              <SessionList
                sessions={sessions}
                selectedSessionId={selectedSession?.id ?? null}
                onSelect={setSelectedSessionId}
                onResume={(session) => void resumeSession(session)}
                resumeDisabled={resumeActionDisabled}
              />
            </section>

            <section className="panel">
              <div className="panel-heading">
                <h2>Telemetry</h2>
              </div>
              <dl className="metric-list">
                <div>
                  <dt>Status</dt>
                  <dd>{telemetry?.status ?? "idle"}</dd>
                </div>
                <div>
                  <dt>Saturation</dt>
                  <dd>{formatPercent(telemetry?.saturation ?? 0)}</dd>
                </div>
                <div>
                  <dt>Entropy</dt>
                  <dd>{(telemetry?.entropy ?? 0).toFixed(2)}</dd>
                </div>
                <div>
                  <dt>Dominant Regions</dt>
                  <dd>{telemetry?.dominantRegions.join(", ") || "None"}</dd>
                </div>
              </dl>
            </section>
          </section>
        </div>
      </main>

      {commandOpen ? (
        <div className="command-overlay" role="dialog" aria-modal="true" aria-label="Command palette">
          <button
            aria-label="Close command palette"
            className="command-backdrop"
            type="button"
            onClick={() => setCommandOpen(false)}
          />
          <div className="command-modal">
            <div className="panel-heading">
              <h2>Command Palette</h2>
              <span className="badge">/ and Cmd/Ctrl+K</span>
            </div>
            <div className="command-list">
              {COMMANDS.map((command) => (
                <button
                  key={command.id}
                  className="command-item"
                  type="button"
                  onClick={() => runCommand(command.id)}
                >
                  <strong>{command.label}</strong>
                  <span>{command.description}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      ) : null}
    </div>
  );
}

function ProviderList(props: {
  providers: readonly GuiProviderDescriptor[];
  activeProvider: string | null;
  onSwitch: (providerId: string) => void;
}): ReactElement {
  if (props.providers.length === 0) {
    return <p className="muted">No providers discovered yet.</p>;
  }

  return (
    <ul className="provider-list">
      {props.providers.map((provider) => {
        const active = props.activeProvider === provider.id;
        return (
          <li key={provider.id}>
            <button
              type="button"
              className={active ? "provider-button active" : "provider-button"}
              onClick={() => props.onSwitch(provider.id)}
              disabled={!provider.available}
            >
              <strong>{provider.label}</strong>
              <span className="muted">{provider.group}</span>
            </button>
            <span className={`status-dot ${provider.available ? "online" : "offline"}`} />
          </li>
        );
      })}
    </ul>
  );
}

function SessionList(props: {
  sessions: readonly GuiSessionSummary[];
  selectedSessionId: string | null;
  onSelect: (sessionId: string) => void;
  onResume: (session: GuiSessionSummary) => void;
  resumeDisabled: boolean;
}): ReactElement {
  const { sessions, selectedSessionId, onSelect, onResume, resumeDisabled } = props;

  if (sessions.length === 0) {
    return (
      <div className="empty-card">
        <p>No persisted sessions yet.</p>
        <span className="muted">Dashboard polling is active and will update automatically.</span>
      </div>
    );
  }

  const selectedIndex = Math.max(
    0,
    sessions.findIndex((session) => session.id === selectedSessionId),
  );

  const onListKeyDown = (event: ReactKeyboardEvent<HTMLUListElement>): void => {
    if (event.key === "ArrowDown") {
      event.preventDefault();
      const nextIndex = selectedIndex >= sessions.length - 1 ? sessions.length - 1 : selectedIndex + 1;
      const nextSession = sessions[nextIndex];
      if (nextSession) {
        onSelect(nextSession.id);
      }
      return;
    }

    if (event.key === "ArrowUp") {
      event.preventDefault();
      const nextIndex = selectedIndex <= 0 ? 0 : selectedIndex - 1;
      const nextSession = sessions[nextIndex];
      if (nextSession) {
        onSelect(nextSession.id);
      }
      return;
    }

    if (event.key === "Enter") {
      event.preventDefault();
      if (resumeDisabled) {
        return;
      }
      const session = sessions[selectedIndex];
      if (session) {
        onResume(session);
      }
    }
  };

  return (
    <ul
      className="session-list"
      tabIndex={0}
      onKeyDown={onListKeyDown}
      aria-label="Recent sessions"
    >
      {sessions.map((session) => (
        <li key={session.id} className={selectedSessionId === session.id ? "session-row selected" : "session-row"}>
          <button
            type="button"
            className={selectedSessionId === session.id ? "session-button active" : "session-button"}
            onClick={() => onSelect(session.id)}
            onDoubleClick={() => {
              if (!resumeDisabled) {
                onResume(session);
              }
            }}
          >
            <strong>{session.title}</strong>
            <span className="muted">{session.provider}</span>
            <span>{formatRelativeTimestamp(session.updatedAt)}</span>
            <span>${session.costUsd.toFixed(4)}</span>
          </button>
          <button
            type="button"
            className="theme-button session-resume-button"
            onClick={() => onResume(session)}
            disabled={resumeDisabled}
          >
            Resume
          </button>
        </li>
      ))}
    </ul>
  );
}

function ThemeButton(props: { active: boolean; label: string; onClick: () => void }): ReactElement {
  return (
    <button
      className={props.active ? "theme-button active" : "theme-button"}
      type="button"
      onClick={props.onClick}
    >
      {props.label}
    </button>
  );
}

function MessageBubble(props: {
  role: TranscriptRole;
  title: string;
  body: string;
  pending?: boolean;
}): ReactElement {
  return (
    <article className={`message ${props.role}${props.pending ? " pending" : ""}`}>
      <header>{props.title}</header>
      <p>{props.body || (props.pending ? "..." : "")}</p>
    </article>
  );
}

function createInitialTranscript(): readonly TranscriptMessage[] {
  return [
    {
      id: createLocalId(),
      role: "system",
      title: "System",
      body: "GUI session transport ready. Connect and submit a prompt to begin.",
    },
  ];
}

function formatActivity(frame: Extract<GuiInboundFrame, { type: "activity" }>): string {
  if (frame.activity === "tool_use") {
    return `Tool started: ${frame.toolName ?? "unknown"}`;
  }
  if (frame.activity === "tool_result") {
    return `Tool result: ${frame.toolName ?? "unknown"}`;
  }
  if (frame.activity === "file_changed") {
    const change = frame.changeType ?? "modified";
    const plus = frame.linesAdded ?? 0;
    const minus = frame.linesRemoved ?? 0;
    return `${change}: ${frame.path ?? "unknown file"} (+${plus} / -${minus})`;
  }
  if (frame.activity === "cost_update") {
    const usd = frame.usd ?? 0;
    return `Cost update: $${usd.toFixed(4)}`;
  }
  if (frame.details) {
    return `${frame.activity}: ${frame.details}`;
  }
  return frame.activity;
}

function readInitialTheme(): ThemeMode {
  if (typeof window === "undefined") {
    return "kiln-dark";
  }

  const stored = window.localStorage.getItem(THEME_STORAGE_KEY);
  if (stored === "kiln-dark" || stored === "kiln-light" || stored === "system") {
    return stored;
  }
  return "system";
}

function resolveTheme(theme: ThemeMode): "kiln-dark" | "kiln-light" {
  if (theme !== "system") {
    return theme;
  }

  return window.matchMedia("(prefers-color-scheme: light)").matches ? "kiln-light" : "kiln-dark";
}

function writeTheme(theme: ThemeMode): void {
  window.localStorage.setItem(THEME_STORAGE_KEY, theme);
}

function formatPercent(value: number): string {
  return `${Math.round(value * 100)}%`;
}

function formatConnectionState(state: GuiSessionConnectionState): string {
  if (state === "connected") {
    return "Connected";
  }
  if (state === "connecting") {
    return "Connecting";
  }
  if (state === "reconnecting") {
    return "Reconnecting";
  }
  return "Disconnected";
}

function formatSessionId(sessionId: string): string {
  return sessionId.length > 8 ? sessionId.slice(0, 8) : sessionId;
}

function formatRelativeTimestamp(value: string): string {
  const date = new Date(value);
  if (Number.isNaN(date.valueOf())) {
    return value;
  }
  return new Intl.DateTimeFormat(undefined, {
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }).format(date);
}

function createLocalId(): string {
  if (typeof crypto !== "undefined" && typeof crypto.randomUUID === "function") {
    return crypto.randomUUID();
  }
  return `msg-${Date.now()}-${Math.random().toString(16).slice(2)}`;
}

function toErrorMessage(error: unknown, fallback: string): string {
  if (error instanceof Error && error.message.length > 0) {
    return error.message;
  }
  if (typeof error === "string" && error.length > 0) {
    return error;
  }
  return fallback;
}
