:root {
  color-scheme: dark;
  --gui-bg: #101414;
  --gui-panel: rgba(20, 27, 27, 0.92);
  --gui-panel-strong: #172021;
  --gui-border: rgba(114, 150, 141, 0.18);
  --gui-text: #edf4ef;
  --gui-muted: #91a4a0;
  --gui-accent: #88d8c0;
  --gui-accent-strong: #53b69a;
  --gui-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
  --gui-system: "IBM Plex Sans", "Segoe UI", sans-serif;
  --gui-mono: "IBM Plex Mono", "Cascadia Code", monospace;
}

:root[data-theme="kiln-light"] {
  color-scheme: light;
  --gui-bg: #f3f1e8;
  --gui-panel: rgba(255, 252, 246, 0.92);
  --gui-panel-strong: #fffaf0;
  --gui-border: rgba(39, 63, 58, 0.16);
  --gui-text: #182120;
  --gui-muted: #5f706c;
  --gui-accent: #15735d;
  --gui-accent-strong: #0c5e4b;
  --gui-shadow: 0 24px 80px rgba(44, 58, 55, 0.12);
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  min-height: 100%;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at top left, rgba(136, 216, 192, 0.16), transparent 32%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 26%),
    var(--gui-bg);
  color: var(--gui-text);
  font-family: var(--gui-system);
}

button,
textarea {
  font: inherit;
}

.gui-shell {
  display: grid;
  grid-template-columns: 20rem minmax(0, 1fr);
  min-height: 100vh;
}

.rail {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.25rem;
  border-right: 1px solid var(--gui-border);
  background: rgba(7, 12, 12, 0.32);
  backdrop-filter: blur(18px);
}

.workspace {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.25rem;
}

.topbar,
.panel-heading,
.composer-actions,
.theme-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.topbar-actions,
.toolbar-actions {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
}

.workspace-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.8fr);
  gap: 1rem;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.panel,
.message,
.command-modal {
  border: 1px solid var(--gui-border);
  border-radius: 1.25rem;
  background: var(--gui-panel);
  box-shadow: var(--gui-shadow);
}

.panel {
  padding: 1rem;
}

.brand-block h1,
.hero h3,
.topbar h2,
.panel-heading h2 {
  margin: 0;
}

.brand-block h1 {
  font-size: 1.75rem;
  line-height: 1;
}

.hero {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 1rem;
}

.eyebrow,
.badge,
.command-button,
.theme-button,
.primary-button {
  font-family: var(--gui-mono);
}

.eyebrow {
  margin: 0 0 0.35rem;
  color: var(--gui-accent);
  font-size: 0.72rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.muted {
  color: var(--gui-muted);
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2rem;
  padding: 0.2rem 0.55rem;
  border-radius: 999px;
  background: rgba(136, 216, 192, 0.13);
  color: var(--gui-accent);
  font-size: 0.74rem;
}

.badge.subtle {
  background: rgba(127, 127, 127, 0.1);
  color: var(--gui-muted);
}

.provider-list,
.session-list,
.metric-list,
.command-list {
  margin: 0;
  padding: 0;
  list-style: none;
}

.provider-list li,
.metric-list div,
.command-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.8rem 0;
}

.provider-list li,
.metric-list div {
  border-top: 1px solid var(--gui-border);
}

.provider-list li:first-child,
.metric-list div:first-child {
  border-top: 0;
  padding-top: 0;
}

.session-list {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.session-list:focus-visible {
  outline: 2px solid color-mix(in srgb, var(--gui-accent) 60%, transparent);
  outline-offset: 2px;
  border-radius: 1rem;
}

.session-row {
  display: flex;
  align-items: stretch;
  gap: 0.6rem;
  padding: 0.55rem;
  border: 1px solid var(--gui-border);
  border-radius: 0.95rem;
  background: rgba(0, 0, 0, 0.09);
}

.session-row.selected {
  border-color: color-mix(in srgb, var(--gui-accent) 58%, transparent);
  background: color-mix(in srgb, var(--gui-accent) 9%, transparent);
}

.session-button {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  width: 100%;
  gap: 0.2rem 0.75rem;
  border: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.session-button strong {
  grid-column: 1 / -1;
}

.session-button.active strong {
  color: var(--gui-accent);
}

.session-button span {
  font-size: 0.9rem;
}

.session-resume-button {
  align-self: center;
  padding: 0.5rem 0.75rem;
}

.session-hint {
  margin: 0 0 0.7rem;
  font-size: 0.86rem;
}

.provider-button {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.2rem;
  width: 100%;
  border: 1px solid transparent;
  border-radius: 0.8rem;
  padding: 0.55rem 0.65rem;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.provider-button.active {
  border-color: color-mix(in srgb, var(--gui-accent) 55%, transparent);
  background: color-mix(in srgb, var(--gui-accent) 10%, transparent);
}

.provider-button:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

.status-dot {
  width: 0.7rem;
  height: 0.7rem;
  border-radius: 50%;
  background: #64706d;
}

.status-dot.online {
  background: var(--gui-accent);
  box-shadow: 0 0 0.8rem rgba(136, 216, 192, 0.5);
}

.transcript-panel {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.transcript {
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
  min-height: 22rem;
  max-height: 56vh;
  overflow: auto;
  padding-right: 0.2rem;
}

.message {
  padding: 1rem;
}

.message header {
  margin-bottom: 0.5rem;
  font-family: var(--gui-mono);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
}

.message.assistant {
  background: linear-gradient(180deg, rgba(83, 182, 154, 0.14), transparent), var(--gui-panel-strong);
}

.message.system {
  background: linear-gradient(180deg, rgba(89, 123, 255, 0.12), transparent), var(--gui-panel-strong);
}

.message.user {
  background: linear-gradient(180deg, rgba(255, 215, 102, 0.11), transparent), var(--gui-panel-strong);
}

.message.activity {
  background: linear-gradient(180deg, rgba(136, 216, 192, 0.09), transparent), var(--gui-panel-strong);
}

.message.error {
  background: linear-gradient(180deg, rgba(255, 116, 127, 0.14), transparent), var(--gui-panel-strong);
}

.message.pending {
  border-color: color-mix(in srgb, var(--gui-accent) 65%, transparent);
}

.message p {
  margin: 0;
  white-space: pre-wrap;
}

.composer {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.composer-input {
  width: 100%;
  resize: vertical;
  min-height: 7rem;
  padding: 1rem;
  border: 1px solid var(--gui-border);
  border-radius: 1rem;
  background: rgba(0, 0, 0, 0.14);
  color: inherit;
}

.composer-input:focus {
  outline: 2px solid color-mix(in srgb, var(--gui-accent) 60%, transparent);
  outline-offset: 2px;
}

.command-button,
.theme-button,
.primary-button {
  padding: 0.75rem 0.95rem;
  border: 1px solid var(--gui-border);
  border-radius: 0.95rem;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.theme-button.active,
.primary-button,
.command-button {
  background: color-mix(in srgb, var(--gui-accent) 16%, transparent);
}

.command-button:disabled,
.theme-button:disabled,
.primary-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.primary-button {
  color: var(--gui-accent);
}

.empty-card {
  display: grid;
  gap: 0.3rem;
  padding: 1rem;
  border-radius: 1rem;
  background: rgba(0, 0, 0, 0.12);
}

.command-overlay {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: start center;
  padding-top: 12vh;
}

.command-backdrop {
  position: absolute;
  inset: 0;
  border: 0;
  background: rgba(3, 8, 8, 0.5);
}

.command-modal {
  position: relative;
  width: min(42rem, calc(100vw - 2rem));
  padding: 1rem;
}

.command-item {
  width: 100%;
  border: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.command-item span {
  color: var(--gui-muted);
}

.alert {
  margin: 0;
  padding: 0.75rem 0.85rem;
  border-radius: 0.85rem;
  border: 1px solid rgba(255, 116, 127, 0.45);
  background: rgba(255, 116, 127, 0.15);
  color: #ffd5da;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 6.8rem;
  padding: 0.45rem 0.7rem;
  border: 1px solid var(--gui-border);
  border-radius: 999px;
  font-family: var(--gui-mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  background: rgba(0, 0, 0, 0.12);
}

.status-pill.connected {
  border-color: color-mix(in srgb, var(--gui-accent) 60%, transparent);
  color: var(--gui-accent);
}

.status-pill.reconnecting,
.status-pill.connecting {
  color: #ffc978;
}

.status-pill.disconnected {
  color: #ff9caa;
}

.badge.subtle.running {
  color: #ffc978;
}

@media (max-width: 1080px) {
  .gui-shell,
  .workspace-grid {
    grid-template-columns: 1fr;
  }

  .rail {
    border-right: 0;
    border-bottom: 1px solid var(--gui-border);
  }

  .transcript {
    max-height: 50vh;
  }
}
