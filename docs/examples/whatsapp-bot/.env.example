# Verify token configured in the Meta WhatsApp webhook console.
MY_WHATSAPP_WEBHOOK_SECRET=

# Access token used by the demo tenant's whatsappAccessToken setting.
MY_WHATSAPP_ACCESS_TOKEN=

# Public HTTPS origin for signed channel media URLs, for example https://abc.ngrok-free.app.
GATEWAY_PUBLIC_URL=

# Private HMAC secret for short-lived public media URLs.
GATEWAY_MEDIA_SIGNING_SECRET=
