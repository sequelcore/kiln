{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.ai/schemas/capability-compatibility/v1",
  "title": "Kiln exact harness capability compatibility record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "harness", "sdk", "runtime", "source", "sourceArtifacts", "capabilities", "fixture", "liveEvidence"],
  "properties": {
    "schema": { "const": "kiln.capability-compatibility/v1" },
    "harness": { "enum": ["codex", "claude", "opencode-v2"] },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "npmIntegrity"],
      "properties": {
        "package": { "type": "string" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "npmIntegrity": { "type": "string", "pattern": "^sha512-" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "observedVersion", "observedAt", "relationshipToSdk"],
      "properties": {
        "name": { "type": "string" },
        "observedVersion": { "type": "string" },
        "observedAt": { "type": "string", "format": "date" },
        "relationshipToSdk": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "commit"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "tag": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "sourceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "origin", "path", "sha256", "supports"],
        "properties": {
          "id": { "type": "string" },
          "origin": { "enum": ["official-repository", "published-npm-package"] },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "supports": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classification", "stability", "eligible", "representation", "semanticLoss", "sourceArtifacts"],
        "properties": {
          "id": { "type": "string" },
          "classification": { "enum": ["portable-function/mcp", "hosted-provider", "harness-private", "lossy/unrepresentable"] },
          "stability": { "enum": ["stable", "private", "experimental"] },
          "eligible": { "type": "boolean" },
          "representation": { "enum": ["lossless", "lossy", "unrepresentable"] },
          "semanticLoss": { "type": "array", "items": { "type": "string" } },
          "sourceArtifacts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "endpoints": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "kind": { "const": "synthetic" }
      }
    },
    "liveEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "command", "bound", "status", "result"],
        "properties": {
          "scope": { "type": "string" },
          "command": { "type": "string" },
          "bound": { "type": "string" },
          "status": { "enum": ["observed", "failed", "not-run"] },
          "result": { "type": "string" }
        }
      }
    }
  }
}
