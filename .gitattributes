# The frontend and backend benchmark verifiers are pinned by a SHA-256 digest
# taken over their raw bytes, and the Dockerfile carries that digest as a label.
# Without a fixed end-of-line, a checkout on a machine with core.autocrlf=true
# rewrites these files and the digest lock fails there while passing on CI.
packages/cli/verifiers/** text eol=lf

# Generated schema projections are compared byte-for-byte with canonical LF
# serializers. Keep checkout bytes stable on Windows as well as CI.
packages/core/schemas/*.json text eol=lf

# CLI schema projections and capability-fabric fixtures are validated by raw
# content or SHA-256. Their checkout bytes are therefore part of the contract.
packages/cli/schemas/*.json text eol=lf
docs/research/fixtures/capability-fabric/v1/**/*.json text eol=lf
